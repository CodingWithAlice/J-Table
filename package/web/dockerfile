# 使用 Node.js 官方镜像作为基础镜像
FROM node:18-alpine

# 设置工作目录
WORKDIR /app/package/web

# 国内服务器优先用 npmmirror，避免 registry.npmjs.org 断连
RUN npm config set registry https://registry.npmmirror.com

# 复制根目录的 package.json 和 package-lock.json
COPY package*.json ../../

# 复制客户端的 package.json 和 package-lock.json
COPY package/web/package*.json ./

# 安装项目依赖（含 serve）
RUN npm install

# 复制客户端代码
COPY package/web .

# 构建客户端项目
RUN npm run build

# 暴露客户端运行的端口，假设为 4001
EXPOSE 4001

# 用本地依赖启动静态服务，避免再单独 npm install -g
CMD ["npx", "serve", "-s", "build", "-l", "4001"]
