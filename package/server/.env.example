## Copy to .env.development / .env.production (do NOT commit real secrets)

# MongoDB
MONGO_URI="mongodb://127.0.0.1:27017/j_table"

# MySQL
DB_HOST="127.0.0.1"
DB_PASSWORD="your_mysql_password"

# DeepSeek — 仅服务端使用，切勿写入前端代码或提交到 Git
DEEPSEEK_API_KEY="sk-your-new-key-after-rotation"

# 与前端 localStorage type / Authorization 一致的鉴权口令
CHECK_AUTH="your-secret-auth-token"
