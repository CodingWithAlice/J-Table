## Local development env
## This file is loaded by ConfigModule via `.env.${NODE_ENV}` (default: development)

# MongoDB (required)
MONGO_URI="mongodb://127.0.0.1:27017/j_table"

# MySQL (required by Sequelize init in app.module.ts)
# If you don't use MySQL locally, you still need to provide something or adjust code.
DB_HOST="127.0.0.1"
DB_PASSWORD="localhost"

